{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "electron"]
  },
  "include": [
    "platforms/electron/**/*.ts",
    "preload/**/*.ts",
    "preload/**/*.d.ts",
    "shared/**/*.ts",
    "electron.vite.config.ts"
  ]
}
